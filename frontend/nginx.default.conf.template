# 后端上游地址由环境变量注入（nginx 官方镜像自动对 /etc/nginx/templates/*.template 做 envsubst）
# 本地 compose 网络：http://ai-love-backend:9000 ；FC 单函数部署：后端函数的 HTTP 触发器 URL
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Vue Router history 模式
    location / {
        try_files $uri $uri/ /index.html;
    }

    # SSE：必须关闭缓冲
    location /ai/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }
    location /knowledge/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        client_max_body_size 20m;
    }
}
